{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "admin",
    "ignore": ["firebase.json", "**/.*"]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
