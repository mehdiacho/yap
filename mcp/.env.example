# Firebase WEB app config for yap-mehdiacho.
#
# These are the same public values the desktop web app ships to browsers — a Firebase
# web apiKey identifies the project, it does not grant access. Access is decided by
# Firebase Auth plus firestore.rules. Nothing secret belongs in this file.
#
# If X:\Projects\yap-desktop\.env exists, this server reads VITE_FB_* from it and you
# can skip this file entirely.
YAP_FB_API_KEY=
YAP_FB_AUTH_DOMAIN=
YAP_FB_PROJECT_ID=yap-mehdiacho
