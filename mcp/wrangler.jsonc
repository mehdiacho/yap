{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yap-mcp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public: required for CIMD, so a client metadata URL can't be
  // pointed back at this zone's own origins.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // One level below the apex on purpose: Universal SSL does not cover deeper names, so
  // mcp.yap.greenforrest.app would serve no valid certificate.
  "routes": [{ "pattern": "yap-mcp.greenforrest.app", "custom_domain": true }],
  // Only the custom domain. A workers.dev address would be a second issuer nobody expects.
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "1a05ac9a33d648299166680af82f491f" }],
  "vars": {
    "FIREBASE_PROJECT_ID": "yap-mehdiacho",
    "FIREBASE_AUTH_DOMAIN": "yap-mehdiacho.firebaseapp.com",
    "PUBLIC_ORIGIN": "https://yap-mcp.greenforrest.app"
  },
  // FIREBASE_API_KEY is set with `wrangler secret put`, and in .dev.vars for wrangler dev.
  "observability": { "enabled": true }
}
