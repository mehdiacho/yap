<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ backup and transfer rules. See backup_rules.xml for the older equivalent.

   cloud-backup excludes media for the quota reason described there. device-transfer is left
   alone on purpose: a direct phone-to-phone move has no 25 MB ceiling, and carrying the
   recordings across means the new device isn't re-downloading a library it could simply
   have been handed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="videos" />
        <exclude domain="file" path="recordings" />
        <exclude domain="file" path="audiocache" />
    </cloud-backup>
</data-extraction-rules>
