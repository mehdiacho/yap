<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_recording"
        android:enabled="true"
        android:icon="@drawable/ic_tile_mic"
        android:shortcutShortLabel="@string/shortcut_record_short"
        android:shortcutLongLabel="@string/shortcut_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.greenforrest.yap"
            android:targetClass="com.mehdiacho.yap.MainActivity">
            <extra android:name="start_recording" android:value="true" />
        </intent>
    </shortcut>

    <!-- Assistant App Action (design · external surfaces): CREATE_NOTE → auto-record. -->
    <capability android:name="actions.intent.CREATE_NOTE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.greenforrest.yap"
            android:targetClass="com.mehdiacho.yap.MainActivity">
            <extra android:name="start_recording" android:value="true" />
        </intent>
    </capability>

    <!-- Direct-share row (design · share sheet): "Transcribe in Yap" for shared audio/video.
         Requires the dynamic shortcut published in MainActivity with the same category. -->
    <share-target android:targetClass="com.mehdiacho.yap.MainActivity">
        <data android:mimeType="audio/*" />
        <data android:mimeType="video/*" />
        <category android:name="com.mehdiacho.yap.category.AUDIO_SHARE" />
    </share-target>
</shortcuts>
