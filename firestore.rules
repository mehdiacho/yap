rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user isolation: a user can only touch their own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Server-managed: users may read their own, never write (admin SDK bypasses rules).
    match /usage/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // promos/* has no client rule at all → fully server-side.
  }
}
