rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user isolation: a user can only touch their own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Server-managed: users may read their own, never write (admin SDK bypasses rules).
    match /usage/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // promos/* has no client rule at all → fully server-side.

    // costMeter/* has no rule either, and must not get one: it is whole-project model spend,
    // from which anyone could read our unit economics and total traffic. It is written by the
    // admin SDK and read only through the admin-gated getCostMeter callable.

    // feedback/* has no rule either. Reports are written by the submitFeedback callable and
    // read only by the admin dashboard: one person's complaint about billing or a bug is not
    // something the next user should be able to page through, and the collection is flat, so
    // any client read rule would expose all of it.

    // adminTags/{uid} has no rule and must not get one: it is our own labelling of accounts
    // ("tester", "Play crawler", "our test") plus a private note about who someone is.
    // Written and read only through the admin-gated callables.

    // byokKeys/{uid} likewise has NO rule, deliberately: it holds users' own provider API
    // keys (encrypted), and not even the owner may read one back. The readable summary
    // (byokActive / byokKeyHint) lives on entitlements/{uid} above. Do not add a rule here.
  }
}
